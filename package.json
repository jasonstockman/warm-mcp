{
  "name": "@warmio/mcp",
  "version": "6.0.0",
  "description": "Warm CLI and MCP server for personal financial data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./warm-api-client": {
      "types": "./dist/warm-api-client.d.ts",
      "default": "./dist/warm-api-client.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "default": "./dist/install.js"
    }
  },
  "bin": {
    "warmio": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.mjs",
    "start": "node dist/index.js mcp",
    "start:http": "node dist/index.js http",
    "start:install": "node dist/index.js install",
    "prepublishOnly": "npm run build",
    "start:mcp": "node dist/index.js mcp"
  },
  "keywords": [
    "mcp",
    "warm",
    "warmio",
    "financial",
    "api",
    "claude",
    "chatgpt"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3"
  }
}
